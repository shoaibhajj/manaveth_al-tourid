# Sanity Studio (phase 2). Copy the names into the project settings; do not commit real values.
# The project ID and dataset only identify the project. They are safe to expose and grant no access.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Optional. Defaults to a fixed API date in sanity/env.ts.
NEXT_PUBLIC_SANITY_API_VERSION=

# Never add read or write tokens as NEXT_PUBLIC_ variables.
# Phase 3 will add server-only tokens here if draft preview needs them.
